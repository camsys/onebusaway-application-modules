    <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="org.hsqldb.jdbcDriver" />
        <property name="url" value="jdbc:hsqldb:mem:org_onebusaway_users" />
        <property name="username" value="sa" />
        <property name="password" value="" />
    </bean>


    <bean class="org.onebusaway.container.spring.SystemPropertyOverrideConfigurer">
        <property name="order" value="-2" />
        <property name="properties">
            <props>
                <prop key="bundlePath">/tmp</prop>
            </props>
        </property>
    </bean>

    <bean class="org.onebusaway.container.spring.PropertyOverrideConfigurer">
        <property name="properties">
            <props>
                <prop key="blockLocationServiceImpl.persistBlockLocationRecords">false</prop>
                <prop key="blockLocationServiceImpl.locationInterpolation">false</prop>
                <prop key="blockStatusServiceImpl.runningLateWindow">3600</prop>
                <prop key="routeBeanServiceImpl.doNotSortRouteIdList">1_H6,1_REX</prop>
                <prop key="configurationServiceClient.externalConfigurationApiUrl">https://adminv2.prod.wmata.obaweb.org/api/config/list</prop>
            </props>
        </property>
    </bean>

    <bean id="wmata_avl" class="org.onebusaway.transit_data_federation.impl.realtime.gtfs_realtime.GtfsRealtimeSource">
        <property name="tripUpdatesUrl" value="https://api.goswift.ly/real-time/wmata/gtfs-rt-trip-updates" />
        <property name="vehiclePositionsUrl" value="https://api.goswift.ly/real-time/wmata/gtfs-rt-vehicle-positions" />
        <property name="refreshInterval" value="5" />
        <property name="agencyIds">
            <list>
                <value>1</value>
            </list>
        </property>
        <property name="showNegativeScheduledArrivals" value="false"/>
        <property name="headersMap">
            <map>
                <entry key="Authorization" value="109318e3874474894d44935c1dae814a"></entry>
            </map>
        </property>
    </bean>

    <bean id="wmata_alerts" class="org.onebusaway.transit_data_federation.impl.realtime.gtfs_realtime.GtfsRealtimeSource">
        <property name="alertCollectionUrl" value="https://adminv2.prod.wmata.obaweb.org/api/alerts/service/1.pb" />
        <property name="refreshInterval" value="300" />
        <property name="alertSourcePrefix" value="WMATA_" />
        <property name="agencyIds">
            <list>
                <value>1</value>
            </list>
        </property>
    </bean>
    <bean id="dash_alerts" class="org.onebusaway.transit_data_federation.impl.realtime.gtfs_realtime.GtfsRealtimeSource">
